# Copy to .env (git-ignored) and fill in. Docker Compose reads it automatically.
# All sign-in values are PUBLIC identifiers from the tenant setup (docs/setup/entra-external-id.md).
# No client secrets exist in this project.

# --- Web app (MSAL in the browser) ---
# SPA application (client) ID
ENTRA_CLIENT_ID=
# Tenant subdomain, e.g. belegflussdev (from belegflussdev.onmicrosoft.com)
ENTRA_TENANT_SUBDOMAIN=
# api://<API client ID>/access_as_user
ENTRA_API_SCOPE=

# --- API (token validation) ---
# Issuer and jwks_uri from
# https://<subdomain>.ciamlogin.com/<tenant-id>/v2.0/.well-known/openid-configuration
BELEGFLUSS_AUTH_ISSUER=
BELEGFLUSS_AUTH_JWKS_URL=
# API client ID (checked against a real token in M1 Phase B)
BELEGFLUSS_AUTH_AUDIENCE=

# --- Local database (dev only) ---
POSTGRES_PASSWORD=belegfluss-dev
